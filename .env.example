# Database (PostgreSQL). If you use the docker-compose.yml, this default works out of the box.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/riskshield?schema=public"

# Used to sign analyst login sessions. Set this to any long random string —
# it just needs to be secret and stay the same between restarts.
# Quick way to generate one: run `openssl rand -base64 32` in a terminal,
# or just mash your keyboard for 32+ characters.
AUTH_SECRET="change-this-to-a-long-random-string-before-using-in-real-life"

# AI Provider settings (optional). Leave AI_API_KEY empty to run in fallback mode --
# the app still works fully, using rule-based deterministic explanations instead of an LLM.
AI_PROVIDER="none"        # one of: "openai" | "anthropic" | "none"
AI_API_KEY=""
AI_MODEL=""               # e.g. "gpt-4o-mini" for openai, "claude-sonnet-4-6" for anthropic

# Public app URL (used for absolute links in dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Override the Python executable name if "python3" isn't on your PATH
# (common on Windows, where it's usually just "python").
# ML_PYTHON_BIN="python"
